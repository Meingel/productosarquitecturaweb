<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ProductosApiNet8-Local</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Productos.Core/Productos.Core.csproj" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.67.0" />
    <Protobuf Include="Protos/productos.proto" GrpcServices="Server" />
    <!-- Reutilizo la configuración original sin cambiar conexiones ni contraseñas. -->
    <Content Include="../appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
