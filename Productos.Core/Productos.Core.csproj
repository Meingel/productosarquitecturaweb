<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Mantengo los archivos originales y los compilo una sola vez en la biblioteca compartida. -->
    <Compile Include="../Models/**/*.cs;../DTOs/**/*.cs;../Data/**/*.cs;../Services/**/*.cs" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.24" />
  </ItemGroup>
</Project>
